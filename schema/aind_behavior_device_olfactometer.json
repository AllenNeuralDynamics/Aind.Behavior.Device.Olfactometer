        "x": {
          "title": "X coordinate",
          "type": "number"
        },
        "y1": {
          "title": "Y1 coordinate",
          "type": "number"
        },
        "y2": {
          "title": "Y2 coordinate",
          "type": "number"
        },
        "z": {
          "title": "Z coordinate",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y1",
        "y2",
        "z"
      ],
      "title": "ManipulatorPosition",
      "type": "object",
      "x-sgen-typename": "AllenNeuralDynamics.AindManipulator.ManipulatorPosition"
    },
    "MicrostepResolution": {
      "description": "Microstep resolution available",
      "enum": [
        0,
