          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Device"
        },
        "output_channel": {
          "description": "Output channel",
          "minimum": 0,
          "title": "Output Channel",
          "type": "integer"
        }
      },
      "required": [
        "output_channel"
      ],
      "title": "ConnectedClockOutput",
      "type": "object"
    },
